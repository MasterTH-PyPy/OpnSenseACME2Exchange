<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OpnSenseACME2Exchange</AssemblyName>
    <RootNamespace>OpnSenseACME2Exchange</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>

    <Version>1.0.0</Version>
    <Product>OpnSenseACME2Exchange</Product>
    <Description>Verteilt das ACME-Zertifikat aus dem OPNsense-HAProxy auf die Exchange-Server</Description>
    <Copyright>Rudolf Kasper</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2025.*" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpnSenseACME2Exchange.Core\OpnSenseACME2Exchange.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="OpnSenseACME2Exchange.app.ico" />
  </ItemGroup>

</Project>
